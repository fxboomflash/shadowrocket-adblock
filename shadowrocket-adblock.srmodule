http-response-jq ^https?://app\.(?:bilibili\.com|biliapi\.(?:net|com))(?::(?:80|443))?/x/v2/feed/index/?(?:\?[^#]*)?$ 'def explicit_ad: if type == "object" then .is_ad == true else false end; def commercial: if type != "object" then false else ((if (.card_type | type) == "string" then (.card_type | startswith("cm_")) else false end) or (if (.card_goto | type) == "string" then (.card_goto | startswith("ad_")) else false end) or .goto == "ad" or .is_ad == true or (.ad_info | explicit_ad)) end; if type == "object" and (.code == null or .code == 0 or .code == "0") and (.data | type) == "object" and (.data.items | type) == "array" then .data.items |= map(if commercial then empty elif type == "object" and (.card_type == "banner_v8" or .card_type == "banner_ipad_v8") and .card_goto == "banner" and (.banner_item | type) == "array" then .banner_item |= map(if type == "object" and (.type == "ad" or .type == "ad_inline") then empty else . end) | select((.banner_item | length) > 0) else . end) else . end'

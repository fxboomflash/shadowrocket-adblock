#!name=广告拦截融合版 · GitHub 固定链接版
#!desc=完整合集：沿用2026-10-18的广告规则，模块及12份依赖迁移至GitHub。保留原代理节点与自己的解密证书；手机实际效果以使用为准。
# 发布日期：2026-10-21；广告逻辑基线：2026-10-18。
# 参考来源及许可见同仓库 SOURCES.md、licenses/ 与各资源原有注释。
# 资源文件名含内容哈希；后续更新保留旧资源，便于回滚。

[General]
force-http-engine-hosts = %APPEND% acs.m.goofish.com, acs.m.taobao.com, g-acs.m.goofish.com, g-acs.m.taobao.com, guide-acs.m.goofish.com, guide-acs.m.taobao.com, app.bilibili.com, app.biliapi.net, app.biliapi.com, grpc.biliapi.net, grpc.bilibili.com, poplayer.template.alibaba.com, api.m.jd.com, h5api.m.goofish.com, h5api.m.taobao.com
# 沿用主配置设置；确保URL改写按规则执行。
always-reject-url-rewrite = true

[Rule]
AND,((DOMAIN,h5api.m.goofish.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,h5api.m.taobao.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,grpc.bilibili.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,poplayer.template.alibaba.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
# AdGuard Mobile 与 Cats-Team 同时列出的广告服务器，补精确主机。
DOMAIN,serveraddr.service.kugou.com,REJECT
DOMAIN,acdn.newshuntads.com,REJECT
# 精确阻断新广告解密主机的UDP443，TCP沿用原分流。
AND,((DOMAIN,fx.service.kugou.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
# B站备用API主机只阻断UDP/443，使其回退HTTPS；TCP沿用主配置分流。
AND,((DOMAIN,api.biliapi.net),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
# 仅上述4个素材主机UDP/443回退到可改写的HTTPS；TCP仍沿用用户主配置分流。
AND,((DOMAIN,i0.hdslb.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,i1.hdslb.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,i2.hdslb.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,upos-sz-static.bilivideo.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
# 仅让完美世界电竞此主机UDP/443回退到可处理的HTTPS；TCP分流继续沿用主配置。
AND,((DOMAIN,api.wmpvp.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
# BooneMotion 审查融合：只保留来源支持的实际域名/子域范围增量。

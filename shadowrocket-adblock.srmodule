[Body Rewrite]
# 闲鱼搜索：只移除明确bizType:ad的推广卡；保留正常商品/筛选/未知字段。
http-response-jq ^https?://g-acs\.m\.goofish\.com(?::(?:80|443))?/gw/mtop\.taobao\.idlemtopsearch\.search/\d+(?:\.\d+)*/?(?:\?[^#]*)?$ 'def success_ret: if (.ret | type) == "array" and (.ret | length) > 0 then all(.ret[]; if type == "string" then startswith("SUCCESS::") else false end) else false end; def commercial: if type == "object" then (try (.data.item.main.exContent.dislikeFeedback.clickParam.args.bizType == "ad") catch false) else false end; if type == "object" and .api == "mtop.taobao.idlemtopsearch.search" and success_ret and (.data | type) == "object" and (.data.resultList | type) == "array" then .data.resultList |= map(select(commercial | not)) else . end'
# 2026-10-07 B站网页推荐：只移除明确广告位，保留普通视频、直播与空商业metadata。
http-response-jq ^https?://api\.(?:bilibili\.com|biliapi\.net)(?::(?:80|443))?/x/web-interface/(?:wbi/)?index/top/feed/rcmd/?(?:\?[^#]*)?$ 'def web_ad: if type != "object" then false else (.goto == "ad" or (if (.business_info | type) == "object" then (if (.business_info.ad_desc | type) == "string" then (.business_info.ad_desc | test("[^[:space:]]")) else false end) else false end)) end; if type == "object" and (.code == null or .code == 0 or .code == "0") and (.data | type) == "object" and (.data.item | type) == "array" then .data.item |= map(select(web_ad | not)) else . end'
# 混合启动资源只清理brand_splash.list，皮肤等其他资源原样保留。
http-response-jq ^https?://app\.(?:bilibili\.com|biliapi\.(?:net|com))(?::(?:80|443))?/x/resource/peak/download/?(?:\?[^#]*)?$ 'if type == "object" and (.code == null or .code == 0 or .code == "0") and (.data | type) == "object" and (.data.resource | type) == "array" then .data.resource |= map(if type == "object" and .type == "brand_splash" and (.list | type) == "array" then .list = [] else . end) else . end'
# 小宇宙首页信息流去掉推广卡片。
http-response-jq ^https?:\/\/api\.xiaoyuzhoufm\.com(?::\d+)?\/v\d+\/discovery-feed\/list 'if type == "object" and (.data | type) == "array" then .data |= map(select((.type // "") != "DISCOVERY_BANNER")) else . end'
